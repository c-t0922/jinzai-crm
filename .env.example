# ローカル開発：`pnpm exec supabase status` の値を .env.local に設定（値はコミットしない）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # seed・管理者のユーザー作成のみで使用
SUPABASE_DB_URL=                    # seed 用（ローカルのみ）
SEED_USER_PASSWORD=                 # 架空ユーザーのローカル用パスワード
APP_TIMEZONE=Asia/Tokyo
MFA_ENFORCE=true                    # 管理者・PM の MFA 必須（E2E のみ false 可）

CTI_MODE=mock                       # mock | twilio
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_CALLER_ID=

KINTONE_MODE=mock                   # mock | live（読み取り専用）
KINTONE_BASE_URL=
KINTONE_APP_ID=
KINTONE_API_TOKEN=

LP_WEBHOOK_SECRET=
